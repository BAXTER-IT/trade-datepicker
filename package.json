{
  "name": "trade-datepicker",
  "version": "7.0.0",
  "description": "Angular datepicker and date range picker",
  "keywords": [
    "Angular",
    "datepicker",
    "date range picker"
  ],
  "author": "Baxtech (Róbert Miszori)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BAXTER-IT/trade-datepicker.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-lib": "node scripts/delete-dist-folder.js && ng build AngularMyDatePicker && node scripts/copy-artifacts.js",
    "build-all": "node scripts/delete-dist-folder.js && ng build AngularMyDatePicker && node scripts/copy-artifacts.js && ng build",
    "test-lib": "node scripts/delete-test-output-folder.js && ng test --code-coverage=true AngularMyDatePicker",
    "lint-lib": "ng lint AngularMyDatePicker",
    "lint": "ng lint"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "~21.2.13",
    "@angular/common": "~21.2.13",
    "@angular/compiler": "~21.2.13",
    "@angular/core": "~21.2.13",
    "@angular/forms": "~21.2.13",
    "@angular/platform-browser": "~21.2.13",
    "@angular/platform-browser-dynamic": "~21.2.13",
    "@angular/router": "~21.2.13",
    "core-js": "^3.30.1",
    "rollup": "^3.20.6",
    "rxjs": "~7.8.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.11",
    "@angular/cli": "~21.2.11",
    "@angular/compiler-cli": "~21.2.13",
    "@angular/language-service": "~21.2.13",
    "@types/jasmine": "~4.3.1",
    "@types/node": "^20.11.0",
    "angular-eslint": "21.4.0",
    "eslint": "^9.39.1",
    "fs-extra": "^11.2.0",
    "jasmine-core": "~4.6.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "ng-packagr": "^21.2.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.59.4"
  }
}
