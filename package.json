{
  "name": "trade-datepicker",
  "version": "3.0.23",
  "description": "Angular datepicker and date range picker",
  "keywords": [
    "Angular",
    "datepicker",
    "date range picker"
  ],
  "author": "baxter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BAXTER-IT/trade-datepicker.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-lib": "node scripts/delete-dist-folder.js && ng build AngularMyDatePicker && node scripts/copy-artifacts.js",
    "build-all": "node scripts/delete-dist-folder.js && ng build AngularMyDatePicker && node scripts/copy-artifacts.js && ng build",
    "test-lib": "node scripts/delete-test-output-folder.js && ng test --code-coverage=true AngularMyDatePicker",
    "lint-lib": "ng lint AngularMyDatePicker"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "~16.2.12",
    "@angular/common": "~16.2.12",
    "@angular/compiler": "~16.2.12",
    "@angular/core": "~16.2.12",
    "@angular/forms": "~16.2.12",
    "@angular/platform-browser": "~16.2.12",
    "@angular/platform-browser-dynamic": "~16.2.12",
    "@angular/router": "~16.2.12",
    "core-js": "^3.30.1",
    "rollup": "^3.20.6",
    "rxjs": "~7.8.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.16",
    "@angular/cli": "~16.2.16",
    "@angular/compiler-cli": "~16.2.12",
    "@angular/language-service": "~16.2.12",
    "@types/jasmine": "~4.3.1",
    "@types/node": "^20.11.0",
    "fs-extra": "^11.2.0",
    "jasmine-core": "~4.6.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "ng-packagr": "^16.2.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.0.0",
    "typescript": "~4.9.5"
  }
}